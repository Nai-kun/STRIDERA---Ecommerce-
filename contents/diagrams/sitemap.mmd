flowchart TD
    Home["/ (Home Storefront)"] --> Shop["/shop (Multi-Seller Catalog & Filters)"]
    Shop --> PDP["/products/[slug] (Product Detail & Reviews)"]
    PDP --> Cart["/cart (Multi-Seller Cart)"]
    Cart --> Checkout["/checkout (Shipping & GCash/Maya/PayPal QR)"]
    Checkout --> OrderDetail["/account/orders/[orderNumber] (Receipt, Tracking, Support)"]

    Home --> Login["/account/login (7-Role Auth & Demo Switcher)"]
    Login --> Register["/account/register (Customer Signup)"]
    Login --> SellerReg["/seller/register (Merchant Application)"]

    Login --> Profile["/account/profile (Role 1: Customer Profile & Tickets)"]
    Login --> SellerDash["/seller/dashboard (Role 2: Seller Hub, Products, Earnings)"]
    SellerDash --> SellerProducts["/seller/products (Product & Variant CRUD)"]
    SellerDash --> SellerOrders["/seller/orders (Accept & Fulfill Order Slices)"]

    Login --> AdminDash["/admin/dashboard (Role 3: 7-Role Governance, Approvals, Config)"]
    Login --> InvPortal["/inventory (Role 4: Inventory Manager Stock & Movements)"]
    Login --> DeliveryPortal["/delivery (Role 5: Delivery Personnel Manifest & POD)"]
    Login --> SupportPortal["/support (Role 6: Customer Support Tickets & Refund Escalation)"]
    Login --> FinancePortal["/finance (Role 7: Finance Officer Verification, Payouts, Refunds)"]
