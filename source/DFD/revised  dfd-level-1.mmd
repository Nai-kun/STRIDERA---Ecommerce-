%% Stridera DFD Level 1 - Main processes (revised)
%% Balanced with dfd-level-0.mmd: every external flow there appears here on exactly one process.
%% Rules: processes touch data stores, never store to store. Read and write flows are separate arrows.
%% D3 exists only if the cart is persisted server-side; drop it if the cart lives in the browser.
%% Stock decrement on payment is written by 4.0; manual stock adjustment is owned by 6.0.
flowchart LR
  SH["Shopper"]
  SE["Seller / Merchant"]
  AD["Administrator / Presenter"]
  PP["E-Wallet Provider (sandbox)"]
  EM["Email Service (Could Have)"]

  P1("1.0 Account and<br/>Role Management")
  P2("2.0 Catalog<br/>and Search")
  P3("3.0 Cart and<br/>Checkout")
  P4("4.0 Payment and<br/>Order Processing")
  P5("5.0 Seller Operations<br/>and Fulfillment")
  P6("6.0 Inventory and<br/>Platform Administration")

  D1[("D1 Users, Sellers<br/>and Brands")]
  D2[("D2 Categories, Products<br/>and Variants (stock)")]
  D3[("D3 Carts<br/>and Cart Items")]
  D4[("D4 Orders, Order Items<br/>and Seller Orders")]
  D5[("D5 Payment Transactions<br/>and Webhook Events")]
  D6[("D6 Stock Movements,<br/>Audit and System Logs")]

  %% ---- External entities <-> processes ----
  SH -->|"registration and login credentials"| P1
  P1 -->|"session, login result, account errors"| SH
  SE -->|"seller registration and login"| P1
  P1 -->|"approval status, session"| SE
  AD -->|"seller approval or rejection, brand assignment, role and status changes"| P1
  P1 -->|"pending sellers, account list"| AD

  SH -->|"search, filters, variant selection"| P2
  P2 -->|"catalog, brands, variants, stock status"| SH

  SH -->|"cart changes, checkout details, wallet choice, Pay Now"| P3
  P3 -->|"cart summary, trusted totals, validation and out-of-stock errors"| SH

  P3 -->|"PENDING order and validated payment request"| P4
  SH -->|"order status and history requests"| P4
  P4 -->|"payment link or QR, order status, Order Confirmed, payment failure message"| SH
  P4 -->|"payment request, payment status lookup"| PP
  PP -->|"payment link or QR, signed webhook, payment status"| P4
  P4 -->|"receipt message"| EM
  EM -->|"delivery failure"| P4

  SE -->|"product, variant and image data, fulfillment updates"| P5
  P5 -->|"own products, own order slices"| SE
  P5 -->|"shipment or cancellation notice"| EM

  SE -->|"stock adjustment requests"| P6
  P6 -->|"updated stock levels, errors"| SE
  AD -->|"inventory overrides, brand and category records, simulate payment request"| P6
  P6 -->|"all orders with payment status, webhook and system logs, masked config status, audit logs"| AD
  P6 -->|"simulate payment request (demo mode, admin only)"| P4
  P4 -->|"simulation result"| P6

  %% ---- 1.0 Account and Role Management ----
  P1 -->|"new accounts, status, brand assignment"| D1
  D1 -->|"credentials, role, status"| P1

  %% ---- 2.0 Catalog and Search ----
  D2 -->|"products, variants, stock"| P2
  D1 -->|"brands"| P2

  %% ---- 3.0 Cart and Checkout ----
  P3 -->|"cart items"| D3
  D3 -->|"cart items"| P3
  D2 -->|"prices, product status, stock"| P3
  D1 -->|"shopper session, seller status"| P3
  P3 -->|"PENDING order, order items, seller orders"| D4
  D4 -->|"existing order for idempotency key"| P3

  %% ---- 4.0 Payment and Order Processing ----
  D4 -->|"order, items, totals"| P4
  P4 -->|"order and seller-order status"| D4
  P4 -->|"payment transaction, webhook event"| D5
  D5 -->|"transaction, processed events"| P4
  P4 -->|"conditional stock decrement"| D2
  D2 -->|"stock result"| P4
  P4 -->|"stock movements, audit, rejected webhook log"| D6

  %% ---- 5.0 Seller Operations and Fulfillment ----
  D1 -->|"seller brand assignment"| P5
  D2 -->|"own products, variants"| P5
  P5 -->|"product, variant, image records"| D2
  D4 -->|"own order slices"| P5
  P5 -->|"fulfillment status, tracking text"| D4
  P5 -->|"stock restore on paid cancellation"| D2
  P5 -->|"stock movements, audit"| D6

  %% ---- 6.0 Inventory and Platform Administration ----
  D1 -->|"role, seller status"| P6
  P6 -->|"brand records"| D1
  D2 -->|"stock levels, variant ownership"| P6
  P6 -->|"adjusted stock, category records"| D2
  D4 -->|"all orders"| P6
  D5 -->|"transactions, webhook events"| P6
  P6 -->|"stock movements, audit"| D6
  D6 -->|"audit and system logs"| P6

  classDef ext fill:#ffffff,stroke:#111111,stroke-width:2px;
  classDef proc fill:#eef7ff,stroke:#1d4ed8,stroke-width:2px;
  classDef store fill:#fff8e6,stroke:#b45309,stroke-width:2px;
  class SH,SE,AD,PP,EM ext;
  class P1,P2,P3,P4,P5,P6 proc;
  class D1,D2,D3,D4,D5,D6 store;
