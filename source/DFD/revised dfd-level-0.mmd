%% Stridera DFD Level 0 - Context diagram (revised)
%% Baseline derived from IPT_revised.pdf. Re-verify every flow against the implemented code in Phase 6.
%% Changes vs the generic spec: Seller added as an external entity; Shipping Provider removed
%% (third-party logistics APIs are Won't Have, fulfillment is a manual seller update);
%% Payment Gateway is an e-wallet sandbox; Email Service is Could Have.
flowchart LR
  SH["Shopper"]
  SE["Seller / Merchant"]
  AD["Administrator / Presenter"]
  PP["E-Wallet Provider (sandbox)"]
  EM["Email Service (Could Have)"]

  P0(("0<br/>Stridera<br/>E-Commerce<br/>System"))

  SH -->|"credentials, search and filters, variant choice, cart changes,<br/>checkout details, wallet choice, Pay Now, order status requests"| P0
  P0 -->|"catalog and stock status, cart totals, payment link or test QR,<br/>Order Confirmed, order history, error messages"| SH

  SE -->|"seller registration, listing and variant data, images,<br/>stock adjustments, fulfillment updates"| P0
  P0 -->|"approval status, own products, own order slices, stock levels"| SE

  AD -->|"seller approvals, brand assignment, role changes, inventory overrides,<br/>simulate payment request"| P0
  P0 -->|"all orders with payment status, webhook and system logs,<br/>masked config status, audit logs"| AD

  P0 -->|"payment request, payment status lookup"| PP
  PP -->|"payment link or QR, signed payment webhook, payment status"| P0

  P0 -->|"receipt and shipment messages"| EM
  EM -->|"delivery failure"| P0

  classDef ext fill:#ffffff,stroke:#111111,stroke-width:2px;
  classDef proc fill:#eef7ff,stroke:#1d4ed8,stroke-width:2px;
  class SH,SE,AD,PP,EM ext;
  class P0 proc;
