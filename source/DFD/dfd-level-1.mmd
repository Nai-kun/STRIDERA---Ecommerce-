    %% External Entities
    Customer["👤 Shopper (Role 1)"]
    Seller["🏪 Seller (Role 2)"]
    Admin["🛡️ Administrator (Role 3)"]
    InvMgr["📦 Inventory Manager (Role 4)"]
    Courier["🚚 Delivery Personnel (Role 5)"]
    Support["🎧 Customer Support (Role 6)"]
    Finance["💰 Finance Officer (Role 7)"]
    Gateway["💳 E-Wallet Gateway (GCash/Maya/PayPal)"]

    %% 9 Core Processes (Per IPT.pdf Level 1 DFD)
    P1(("1.0\nUser Auth &\n7-Role RBAC"))
    P2(("2.0\nCatalog, Search &\nReview Management"))
    P3(("3.0\nCart & Multi-Seller\nOrder Slicing"))
    P4(("4.0\nE-Wallet Payment &\nWebhook Verification"))
    P5(("5.0\nSeller Storefront &\nOrder Fulfillment"))
    P6(("6.0\nWarehouse Inventory\n& Stock Movements"))
    P7(("7.0\nCourier Dispatch &\nProof of Delivery"))
    P8(("8.0\nCustomer Support &\nRefund Escalation"))
    P9(("9.0\nFinance, Payouts &\nPlatform Governance"))

    %% Data Stores
    D1[("D1: Users & Addresses")]
    D2[("D2: Products, Variants & Reviews")]
    D3[("D3: Orders & SellerOrder Slices")]
    D4[("D4: Payments & Seller Payouts")]
    D5[("D5: Stock Movements")]
    D6[("D6: Shipments & Waybills")]
    D7[("D7: Support Tickets & Messages")]
    D8[("D8: Audit Logs & PlatformConfig")]

    %% Process Flows
    Customer --> P1 & P2 & P3 & P4 & P8
    Seller --> P1 & P5
    Admin --> P1 & P9
    InvMgr --> P6
    Courier --> P7
    Support --> P8
    Finance --> P9

    P1 <--> D1 & D8
    P2 <--> D2
    P3 <--> D2 & D3
    P4 <--> Gateway
    P4 <--> D3 & D4 & D8
    P5 <--> D2 & D3 & D6
    P6 <--> D2 & D5 & D8
    P7 <--> D3 & D6 & D8
    P8 <--> D3 & D7 & D8
    P9 <--> D1 & D3 & D4 & D7 & D8

