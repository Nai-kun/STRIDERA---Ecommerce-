# Environment Variables — STRIDERA Backend
# Copy to .env and fill in values. NEVER commit .env with real secrets.

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://stridera_user:your_password@localhost:5432/stridera_db

# JWT & Session Encryption
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=30d
SETTINGS_ENCRYPTION_KEY=change-this-32-byte-hex-or-passphrase-for-settings

# CSRF
CSRF_SECRET=change-this-to-another-random-string

# Demo Fallback (OFF by default)
DEMO_MODE=false
DEMO_FALLBACK_ENABLED=false

# Shipping & PSGC Philippine Address API (No API key required)
DEFAULT_SHIPPING_FEE_CENTAVOS=15000
PSGC_API_BASE_URL=https://psgc.gitlab.io/api
PSGC_TIMEOUT_MS=8000
PSGC_MAX_RETRIES=2
PSGC_CACHE_TTL_MS=86400000

# Email (sandbox — logs to console if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@stridera.com
